{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "rootDir": "src",
        "outDir": "dist",

        "declaration": true,
        "sourceMap": true,

        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,

        "types": ["node"],
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"],
}
