{
    "name": "waypoint",
    "main": "src/main.ts",
    "type": "module",
    "private": true,
    "version": "0.0.0",
    "description": "The Spawnpad backend",
    "scripts": {
        "dev": "tsx --watch src/main.ts",
        "build": "tsc",
        "start": "node dist/main.js",
        "db:generate": "drizzle-kit generate --config src/external/drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config src/external/drizzle.config.ts",
        "db:push": "drizzle-kit push --config src/external/drizzle.config.ts",
        "db:studio": "drizzle-kit studio --config src/external/drizzle.config.ts"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.23.12"
    },
    "dependencies": {
        "@fastify/websocket": "^11.3.0",
        "@sentry/node": "^10.71.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.12.1",
        "pg": "^8.23.0",
        "ulid": "^3.0.2"
    }
}
