{
    "name": "rojo",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "format": "stylua src && prettier --write .",
        "format:check": "pnpm lint",
        "lint": "selene src",
        "dev": "concurrently \"pnpm -F waypoint dev\" \"rojo serve\"",
        "build": "rojo build && pnpm -F waypoint build",
        "start": "pnpm -F waypoint start",
        "db:generate": "pnpm -F waypoint db:generate",
        "db:migrate": "pnpm -F waypoint db:migrate",
        "db:push": "pnpm -F waypoint db:push",
        "db:studio": "pnpm -F waypoint db:studio"
    },
    "keywords": [],
    "author": "",
